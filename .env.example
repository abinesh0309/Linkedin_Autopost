# Both variables are optional.
#
# The backend URL is normally set from the running app: Sidebar > Settings.
# It is saved in the browser and takes effect immediately.
#
# VITE_API_BASE_URL is only a default for first-time visitors. On Vercel, add it
# under Project Settings > Environment Variables if you have a stable backend
# URL (for example a reserved ngrok domain); leave it blank for a demo-mode site.
VITE_API_BASE_URL=

# "true" forces demo mode (simulated data, no network calls) even if a URL is set.
VITE_MOCK_MODE=false
