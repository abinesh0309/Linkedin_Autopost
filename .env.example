# All variables are optional. They are baked in at build time, so after changing
# one on Vercel you must redeploy.
#
# The backend URL can always be set from the running app (Sidebar > Settings);
# that value is saved in the browser and takes effect immediately.
#
# VITE_API_BASE_URL is the default address for everyone who opens the site. Use it
# with a fixed ngrok domain (NGROK_DOMAIN secret in the notebook) and the site
# connects to Kaggle by itself every time you start the notebook.
VITE_API_BASE_URL=

# "true" removes demo mode: until the backend answers, the site only shows
# "Connect the backend to run", then switches to the app by itself.
# Use this for a live presentation. Leave it "false" for a clickable demo site.
VITE_REQUIRE_BACKEND=false

# "true" forces demo mode (simulated data, no network calls) even if a URL is set.
# Ignored when VITE_REQUIRE_BACKEND is true.
VITE_MOCK_MODE=false
